# Copy to .env in the repository root and fill in the values.
# .env is ignored by git. Never paste a key into a notebook.

# Course model endpoint : the OpenRouter key the trainer hands out
COURSE_API_KEY=
# Optional overrides ; the setup cell has defaults
COURSE_RPS=0.3
COURSE_MODEL=openai/gpt-6-luna
COURSE_BASE_URL=https://openrouter.ai/api/v1

# Optional : LangSmith tracing, Studio and langgraph dev
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ari520
# EU region account ; remove for a US account
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional : web search tool, trainer demos only
TAVILY_API_KEY=
